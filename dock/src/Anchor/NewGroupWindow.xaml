<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anchor.NewGroupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Anchor.Localization">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: extended into so the Mica backdrop flows edge-to-edge and the
             caption matches a native Windows 11 window (no opaque white strip). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <FontIcon Glyph="&#xE838;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{loc:Localize Key=Flyout.NewGroup}" Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,8,24,20" RowSpacing="18" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Icon and name share a line, the same way the item editor pairs them: the icon box
                 is sized to what is in it and the name field takes the rest. -->
            <Grid Grid.Row="0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="IconButton" Grid.Column="0" Width="56" Height="56" MinWidth="0" MinHeight="0"
                        Padding="0" CornerRadius="12"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        Click="ChangeIcon_Click"
                        ToolTipService.ToolTip="{loc:Localize Key=IconPicker.Title}"
                        AutomationProperties.Name="{loc:Localize Key=IconPicker.Title}">
                    <Grid x:Name="IconPreview" Width="28" Height="28" />
                </Button>

                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localize Key=Flyout.Name}" />
                    <TextBox x:Name="NameBox"
                             AutomationProperties.Name="{loc:Localize Key=Flyout.Name}" />
                </StackPanel>
            </Grid>

            <!-- What a group is and how to fill it — there is nothing else to explain here, since
                 a fresh group has no children yet. -->
            <TextBlock Grid.Row="1"
                       Text="{loc:Localize Key=Add.Group.Hint}"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />

            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{loc:Localize Key=Common.Cancel}" MinWidth="96" Click="Cancel_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="CreateButton" Content="{loc:Localize Key=Flyout.CreateGroup}" MinWidth="120"
                        Style="{ThemeResource AccentButtonStyle}" Click="Create_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
