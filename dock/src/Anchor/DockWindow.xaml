<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anchor.DockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Anchor.Models"
    xmlns:loc="using:Anchor.Localization"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- The window itself is the glass: the acrylic backdrop paints this whole surface
         and DWM rounds its corners. RequestedTheme here is only the pre-load default
         (Dark, matching the Win11 dark taskbar); the code-behind sets the real theme from
         the user's Light/Dark/System choice (see ApplyTheme). Under a High Contrast theme
         that resolves to ElementTheme.Default and an opaque system background is painted so
         the shell's high-contrast colors come through instead. -->
    <Grid x:Name="RootGrid" Background="Transparent" RequestedTheme="Dark"
          AutomationProperties.AutomationId="AnchorDockRoot"
          AllowDrop="True" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid.Resources>
            <!-- Windows-11-taskbar-style icon chrome: a rounded, theme-aware fill that appears on
                 hover/press. The default ButtonStyle's own PointerOver/Pressed fill exists too,
                 but it reads as too dim to register as a hover cue against the acrylic backdrop —
                 hence a small custom template instead of trying to recolor the built-in one. The
                 Fluent "Subtle" brush family is the same one NavigationViewItem/ListViewItem
                 hover uses, so this matches the rest of Windows 11 rather than inventing a color.
                 System focus visuals (Tab-key navigation) are unaffected — they are drawn by the
                 platform independent of template content, not by a template part.

                 Every cell that wants the dock's chrome shares this one style: the strip's items,
                 the gear, the empty-state pill, and the cells in a group's fly-out bar (which
                 reaches for it by key, see DockWindow.FlyoutBar.BuildBarCell) — so the hover on an
                 item is by construction the same hover the gear gets. -->
            <Style x:Key="DockGlassButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="Transparent"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Chrome.Background"
                                                        Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Chrome.Background"
                                                        Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Chrome.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Border x:Name="DockStrip"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                CornerRadius="8"
                Padding="8,6">

            <StackPanel x:Name="Strip"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        XYFocusKeyboardNavigation="Enabled">

                <!-- Empty-state affordance: when the dock has no (visible) items this "+ Add New"
                     pill is shown in their place. Clicking it opens the Add-to-Dock window. -->
                <Button x:Name="AddNewButton"
                        Style="{StaticResource DockGlassButtonStyle}"
                        Height="40"
                        MinWidth="0"
                        MinHeight="0"
                        Padding="12,0"
                        Visibility="Collapsed"
                        AutomationProperties.AutomationId="AnchorAddNewButton"
                        AutomationProperties.Name="{loc:Localize Key=Dock.AddNewName}"
                        Click="AddNew_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{loc:Localize Key=Dock.AddNewTip}" />
                    </ToolTipService.ToolTip>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE710;"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="16"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{loc:Localize Key=Dock.AddNew}"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Button>

                <muxc:ItemsRepeater x:Name="ItemsHost"
                                    AutomationProperties.AutomationId="AnchorDockItems">
                    <muxc:ItemsRepeater.Layout>
                        <muxc:StackLayout Orientation="Horizontal" Spacing="4" />
                    </muxc:ItemsRepeater.Layout>

                    <!-- One template for every kind. A launchable item renders as a real Button:
                         keyboard-focusable, Space/Enter invoke, focus visuals, hover/pressed
                         states, and an Invoke automation pattern come from the platform for free.
                         A Separator renders the hairline instead and hides the button, rather than
                         living in a second template — the cell Grid, its Tag (which is how the
                         drag/reorder and context-menu code finds the item) and the context-menu
                         wiring are then identical for both, and only the visual differs.

                         The cell's own size comes from the item (CellWidth / CellHeight) because a
                         separator's slot is much narrower than an icon's, and which axis is the
                         narrow one flips with the strip's orientation.

                         AutomationProperties.Name is what Narrator announces; the icon visuals and
                         the (decorative) separator line are marked Raw so they are not announced
                         separately. -->
                    <muxc:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:DockItem">
                            <!-- AllowDrop on the cell as well as on the root: a file dropped onto
                                 an APP opens with that app, and one dropped onto a GROUP is filed
                                 into it, while a drop anywhere else on the strip still adds an
                                 item (see Item_DragOver / Item_Drop, which mark the event handled
                                 only when they take one of those two paths). -->
                            <Grid Width="{x:Bind CellWidth, Mode=OneWay}"
                                  Height="{x:Bind CellHeight, Mode=OneWay}"
                                  Opacity="{x:Bind CellOpacity, Mode=OneWay}"
                                  Background="Transparent"
                                  Tag="{x:Bind}"
                                  AllowDrop="True"
                                  DragEnter="Item_DragEnter"
                                  DragOver="Item_DragOver"
                                  DragLeave="Item_DragLeave"
                                  Drop="Item_Drop"
                                  ContextRequested="Item_ContextRequested">
                                <!-- The hover highlight, drawn under the button rather than by it.
                                     Same brush and same corner the gear's own PointerOver state
                                     uses, so a hovered item and a hovered gear are the same cue;
                                     what differs is only what decides when to show it — here the
                                     strip's pointer tracking (DockWindow.TrackStripPointer), which
                                     works whether or not magnification is switched on. Not
                                     hit-testable, so it cannot come between the cursor and the
                                     button it is highlighting. -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{x:Bind CellCorner, Mode=OneWay}"
                                        Opacity="{x:Bind HoverOpacity, Mode=OneWay}"
                                        IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw" />

                                <!-- The drop shell: the empty slot the strip opens up while
                                     something is dragged in from outside, standing where the drop
                                     will land (see DockWindow.DropTargets, TrackDropShell). Only
                                     the transient placeholder item ever shows it, so every real
                                     cell binds this to Collapsed and pays nothing for it. The
                                     hairline outline is what tells it apart from the hover fill
                                     above, which is otherwise the same rounded rectangle. -->
                                <Grid Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"
                                      IsHitTestVisible="False"
                                      AutomationProperties.AccessibilityView="Raw">
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="{x:Bind CellCorner, Mode=OneWay}" />
                                    <Border BorderBrush="{ThemeResource TextFillColorPrimaryBrush}"
                                            BorderThickness="1"
                                            Opacity="0.25"
                                            CornerRadius="{x:Bind CellCorner, Mode=OneWay}" />
                                </Grid>

                                <!-- Sized to the cell, exactly as the gear below is. Without it the
                                     button takes its size from its content — a 24px icon in a 40px
                                     cell — and sits at the cell's leading edge rather than in the
                                     middle of it, which puts the icon 8px left of the highlight
                                     drawn behind it and leaves two thirds of the cell dead to the
                                     pointer. -->
                                <Button Style="{StaticResource DockGlassButtonStyle}"
                                        Width="{x:Bind CellWidth, Mode=OneWay}"
                                        Height="{x:Bind CellHeight, Mode=OneWay}"
                                        MinWidth="0"
                                        MinHeight="0"
                                        CornerRadius="{x:Bind CellCorner, Mode=OneWay}"
                                        Visibility="{x:Bind ButtonVisibility}"
                                        AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                        AutomationProperties.ItemStatus="{x:Bind RunningStatus, Mode=OneWay}"
                                        ToolTipService.Placement="Top"
                                        Click="Item_Click">
                                    <ToolTipService.ToolTip>
                                        <ToolTip Content="{x:Bind DisplayName, Mode=OneWay}" />
                                    </ToolTipService.ToolTip>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <Grid HorizontalAlignment="Center">
                                        <Image Source="{x:Bind IconImage, Mode=OneWay}"
                                               Visibility="{x:Bind ImageVisibility, Mode=OneWay}"
                                               Width="{x:Bind RenderIconSize, Mode=OneWay}"
                                               Height="{x:Bind RenderIconSize, Mode=OneWay}"
                                               Stretch="Uniform"
                                               AutomationProperties.AccessibilityView="Raw" />

                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                                  Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="{x:Bind RenderGlyphSize, Mode=OneWay}"
                                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                  AutomationProperties.AccessibilityView="Raw" />

                                        <!-- The same glyph in the colour picked for it (a group's
                                             editor). A twin rather than a bound Foreground on the
                                             one above, so that one keeps following the theme. -->
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                                                  Visibility="{x:Bind TintedGlyphVisibility, Mode=OneWay}"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  FontSize="{x:Bind RenderGlyphSize, Mode=OneWay}"
                                                  Foreground="{x:Bind GlyphTint, Mode=OneWay}"
                                                  AutomationProperties.AccessibilityView="Raw" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                   Visibility="{x:Bind LabelVisibility, Mode=OneWay}"
                                                   FontSize="9"
                                                   MaxWidth="{x:Bind CellWidth, Mode=OneWay}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                   AutomationProperties.AccessibilityView="Raw" />
                                    </StackPanel>
                                </Button>

                                <!-- Running-app indicator: a dot under the icon, as on a Mac, drawn
                                     over the bottom of the cell. Not hit-testable, so it never
                                     intercepts the click it sits on top of; the state it shows
                                     reaches assistive technology through the button's ItemStatus
                                     above rather than through this (decorative) visual. -->
                                <Border Visibility="{x:Bind RunningIndicatorVisibility, Mode=OneWay}"
                                        Width="5"
                                        Height="5"
                                        CornerRadius="2.5"
                                        Margin="0,0,0,1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw" />

                                <!-- The same dot in amber while the app asks for attention (its window
                                     flashed, as a taskbar button turns orange): a UAC prompt waiting for an
                                     app in the background, say. -->
                                <Border Visibility="{x:Bind AttentionIndicatorVisibility, Mode=OneWay}"
                                        Width="5"
                                        Height="5"
                                        CornerRadius="2.5"
                                        Margin="0,0,0,1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Bottom"
                                        Background="{ThemeResource SystemFillColorCautionBrush}"
                                        IsHitTestVisible="False"
                                        AutomationProperties.AccessibilityView="Raw" />

                                <!-- Separator: the same hairline treatment as the gear divider
                                     below, so a user-placed divider and the built-in one read as
                                     one design rather than two. -->
                                <Rectangle Visibility="{x:Bind SeparatorVisibility}"
                                           Width="{x:Bind SeparatorLineWidth, Mode=OneWay}"
                                           Height="{x:Bind SeparatorLineHeight, Mode=OneWay}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="{ThemeResource TextFillColorPrimaryBrush}"
                                           Opacity="0.15"
                                           AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                        </DataTemplate>
                    </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>

                <!-- Divider between user items and the settings button (decorative:
                     hidden from assistive technology). -->
                <Rectangle x:Name="Divider"
                           Width="1"
                           Height="24"
                           Fill="{ThemeResource TextFillColorPrimaryBrush}"
                           Opacity="0.15"
                           AutomationProperties.AccessibilityView="Raw" />

                <!-- Settings (gear) button -->
                <!-- Width/Height/FontSize are set from DockMetrics in code (see ApplyMetrics):
                     they track the density setting, and XAML has no way to bind a static. -->
                <Button x:Name="SettingsButton"
                        Style="{StaticResource DockGlassButtonStyle}"
                        Width="40"
                        Height="40"
                        MinWidth="0"
                        MinHeight="0"
                        AutomationProperties.AutomationId="AnchorSettingsButton"
                        AutomationProperties.Name="{loc:Localize Key=Dock.Settings}"
                        Click="Settings_Click">
                    <ToolTipService.ToolTip>
                        <ToolTip Content="{loc:Localize Key=Dock.Settings}" />
                    </ToolTipService.ToolTip>
                    <FontIcon x:Name="SettingsGlyph"
                              Glyph="&#xE713;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="18"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Hidden-state notch. When the dock is snapped and auto-hidden it slides off the
             screen leaving only a thin peek; this rounded "handle" pokes into that peek band
             so the hidden dock is easy to find and pull back out. Its alignment is flipped to
             the correct edge in code (see DockWindow.AutoHide.cs). -->
        <Border x:Name="Notch"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="62"
                Height="10"
                CornerRadius="5"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="0.9"
                IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw" />

        <!-- Drag ghost: while an item reorder is in progress (see DockWindow.xaml.cs,
             UpdateItemReorder), this floating copy of the dragged icon tracks the pointer along
             the strip's flow axis, positioned each tick via Canvas.Left/Top. The item's own cell
             stays in the strip (dimmed via CellOpacity) so the list still visibly reorders under
             it; this is what makes the reorder read as "holding" the icon rather than just
             watching the list reshuffle. Last in z-order so it draws above every cell. -->
        <Canvas IsHitTestVisible="False">
            <Border x:Name="DragGhost"
                    Visibility="Collapsed"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    AutomationProperties.AccessibilityView="Raw">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image x:Name="DragGhostImage"
                           Stretch="Uniform"
                           AutomationProperties.AccessibilityView="Raw" />
                    <FontIcon x:Name="DragGhostGlyph"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                              AutomationProperties.AccessibilityView="Raw" />
                    <FontIcon x:Name="DragGhostTintedGlyph"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
