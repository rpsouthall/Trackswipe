<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anchor.AddNewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Anchor.Localization">

    <!-- AllowDrop on the root: anything dropped anywhere in the window fills in the form below
         (its type, path and name), not only a drop on the "Drag 'n drop" zone — see Root_DragOver
         / Root_Drop. -->
    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="Root_DragOver" DragLeave="Root_DragLeave"
          Drop="Root_Drop" Background="Transparent">
        <Grid.Resources>
            <!-- The rows of the list shown when several items are dropped at once. Styles rather
                 than brushes pulled from the app's resources in code, so the row follows this
                 window's own Light/Dark choice instead of the system's. -->
            <Style x:Key="DroppedRowStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,8,6,8" />
            </Style>
            <Style x:Key="DroppedSecondaryStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: extended into so the Mica backdrop flows edge-to-edge and the
             caption matches a native Windows 11 window (no opaque white strip). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{loc:Localize Key=Add.Title}" Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,8,24,24" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
                <Border Width="44" Height="44" CornerRadius="10"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="22" Foreground="White" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localize Key=Add.Title}" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock Text="{loc:Localize Key=Add.Subtitle}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Type selector -->
            <StackPanel Grid.Row="1" Spacing="8">
                <TextBlock Text="{loc:Localize Key=Add.What}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <!-- The eight type tiles share one row. They are star-sized columns rather than
                     fixed-width tiles so they always fill exactly the 692 DIP left after the
                     window's own padding, whatever the DPI or font scale: (692 - 7 * 6 spacing)
                     / 8 = ~81 DIP each. Height and spacing carry a little extra buffer: several
                     translations (e.g. German "Verknüpfung" for Add.TypeShortcut) wrap to two
                     lines at this width, and tiles aren't clipped by their parent, so a cramped
                     gutter would let a wrapped label visually run into the next tile. -->
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="AppType" Grid.Column="0" Click="TypeSelected" Height="80" Padding="2,0" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="{loc:Localize Key=Add.TypeApp}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{loc:Localize Key=Add.TypeApp}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="FileType" Grid.Column="1" Click="TypeSelected" Height="80" Padding="2,0" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="{loc:Localize Key=Add.TypeFile}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{loc:Localize Key=Add.TypeFile}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="FolderType" Grid.Column="2" Click="TypeSelected" Height="80" Padding="2,0" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="{loc:Localize Key=Add.TypeFolder}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8B7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{loc:Localize Key=Add.TypeFolder}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="LinkType" Grid.Column="3" Click="TypeSelected" Height="80" Padding="2,0" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="{loc:Localize Key=Add.TypeLink}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE71B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{loc:Localize Key=Add.TypeLink}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ShortcutType" Grid.Column="4" Click="TypeSelected" Height="80" Padding="2,0" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="{loc:Localize Key=Add.TypeShortcut}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8A7;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{loc:Localize Key=Add.TypeShortcut}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="SeparatorType" Grid.Column="5" Click="TypeSelected" Height="80" Padding="2,0" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="{loc:Localize Key=Add.TypeSeparator}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE76F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{loc:Localize Key=Add.TypeSeparator}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="GroupType" Grid.Column="6" Click="TypeSelected" Height="80" Padding="2,0" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="{loc:Localize Key=Add.TypeGroup}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <!-- FolderOpen, matching the Group kind's own default icon
                                 (DockItem.Glyph) — previously this duplicated the App tile's
                                 AllApps glyph, which read as the same type twice. -->
                            <FontIcon Glyph="&#xE838;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{loc:Localize Key=Add.TypeGroup}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="DropType" Grid.Column="7" Click="TypeSelected" Height="80" Padding="2,0" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Center"
                                  AutomationProperties.Name="{loc:Localize Key=Add.TypeDrop}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <!-- Download: an arrow into a tray, the shell's own "drop it here" glyph. -->
                            <FontIcon Glyph="&#xE896;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="22"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{loc:Localize Key=Add.TypeDrop}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="2" Spacing="14" VerticalAlignment="Top">
                <!-- The "Drag 'n drop" type: an empty drop target shown instead of the fields
                     below, while nothing has been dropped yet. A drop — here or anywhere else in
                     the window — switches to the type it turns out to be and fills the fields in. -->
                <Grid x:Name="DropZone" Height="200" Visibility="Collapsed"
                      AutomationProperties.Name="{loc:Localize Key=Add.Drop.Prompt}">
                    <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="2" StrokeDashArray="4,3"
                               Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                               Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                    <!-- Shown over the outline while a droppable drag is over the window. -->
                    <Rectangle x:Name="DropZoneHighlight" RadiusX="8" RadiusY="8" StrokeThickness="2"
                               Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                               Fill="{ThemeResource SubtleFillColorSecondaryBrush}"
                               Visibility="Collapsed" />
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                Padding="24,0" MaxWidth="520">
                        <FontIcon Glyph="&#xE896;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="{loc:Localize Key=Add.Drop.Prompt}" TextAlignment="Center"
                                   TextWrapping="Wrap" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{loc:Localize Key=Add.Drop.Hint}" TextAlignment="Center"
                                   TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- Several items dropped together. The fields below hold one target and one name,
                     so a drop of several is listed here instead — each with the type, name and path
                     it will be added as — and the Add button adds them all. -->
                <StackPanel x:Name="DroppedPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="DroppedHeader" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DroppedList" Spacing="6" />
                    </ScrollViewer>
                </StackPanel>

                <StackPanel x:Name="TargetPanel" Spacing="6">
                    <TextBlock x:Name="TargetLabel" />
                    <!-- Collapsed for the Separator type, which has no target to point at: the
                         hint below stays visible and explains what will be added. -->
                    <Grid x:Name="TargetRow" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- AllowDrop is off on the three text boxes so that a drop onto one is the
                             window's drop, like a drop anywhere else, rather than the box's own
                             insert-the-text one: a link dropped on a field fills the whole form in. -->
                        <TextBox x:Name="TargetBox" Grid.Column="0" AllowDrop="False"
                                 PlaceholderText="{loc:Localize Key=Add.TargetPlaceholder}"
                                 TextChanged="TargetBox_TextChanged" />
                        <Button x:Name="BrowseButton" Grid.Column="1" Content="{loc:Localize Key=Add.Browse}"
                                Click="Browse_Click" />
                    </Grid>
                    <TextBlock x:Name="TargetHint"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="NamePanel" Spacing="6">
                    <TextBlock Text="{loc:Localize Key=Add.DisplayName}" />
                    <TextBox x:Name="NameBox" AllowDrop="False" PlaceholderText="{loc:Localize Key=Add.DisplayNamePlaceholder}" />
                </StackPanel>

                <StackPanel x:Name="ArgsPanel" Spacing="6">
                    <TextBlock Text="{loc:Localize Key=Add.Args}" />
                    <TextBox x:Name="ArgsBox" AllowDrop="False" PlaceholderText="{loc:Localize Key=Add.ArgsPlaceholder}" />
                </StackPanel>

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="False" />
            </StackPanel>

            <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{loc:Localize Key=Common.Cancel}" MinWidth="96"
                        Click="Cancel_Click">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="AddButton" Content="{loc:Localize Key=Add.Submit}" MinWidth="140"
                        Style="{ThemeResource AccentButtonStyle}" Click="Add_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
