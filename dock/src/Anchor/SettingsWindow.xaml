<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anchor.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Anchor.Localization"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <!-- NOTE: WinUI 3's Window is not a FrameworkElement and has no Resources property, so
         shared resources live on the root Grid, not on <Window.Resources>. -->
    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <!-- The dimmed second line under a setting's or an item's name.

                 These exist as styles, and are reached by key from the code that builds the Docks
                 and Apps & links rows, because that code cannot look the brush up for itself. This
                 window picks its own Light/Dark theme from the user's choice, which is not
                 necessarily the application's, and `Application.Current.Resources["…"]` resolves
                 against the application's — so a Light window was painting its descriptions in the
                 Dark theme's near-white and they vanished into the card. A {ThemeResource} inside a
                 Style is resolved against the element the style lands on, which is the right
                 theme by construction. -->
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryCaption" TargetType="TextBlock"
                   BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: extended into so the Mica backdrop flows edge-to-edge and the
             caption matches a native Windows 11 window (no opaque white strip). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{loc:Localize Key=Settings.Title}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView x:Name="Nav"
                             Grid.Row="1"
                             IsSettingsVisible="False"
                             IsBackButtonVisible="Collapsed"
                             IsTitleBarAutoPaddingEnabled="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="200"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="GeneralNav" Content="{loc:Localize Key=Nav.General}"
                                         AutomationProperties.AutomationId="SettingsNavGeneral"
                                         IsSelected="True" Tag="general">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="AppearanceNav" Content="{loc:Localize Key=Nav.Appearance}"
                                         AutomationProperties.AutomationId="SettingsNavAppearance"
                                         Tag="appearance">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="ShortcutsNav" Content="{loc:Localize Key=Nav.Shortcuts}"
                                         AutomationProperties.AutomationId="SettingsNavShortcuts"
                                         Tag="shortcuts">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="DocksNav" Content="{loc:Localize Key=Nav.Docks}"
                                         AutomationProperties.AutomationId="SettingsNavDocks"
                                         Tag="docks">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C4;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="AppsNav" Content="{loc:Localize Key=Nav.Apps}"
                                         AutomationProperties.AutomationId="SettingsNavApps"
                                         Tag="apps">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <!-- FooterMenuItems, not PaneFooter: it shares the same single-selection model as
                 MenuItems (SelectionChanged, IsSelected) so the item behaves like the others, just
                 pinned to the bottom of the pane. PaneFooter is plain content and doesn't. -->
            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem x:Name="AboutNav" Content="{loc:Localize Key=Nav.About}" Tag="about"
                                         AutomationProperties.AutomationId="SettingsNavAbout">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <Grid Padding="32,24,32,24">
                <!-- ==================== GENERAL ==================== -->
                <ScrollViewer x:Name="GeneralPanel" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                        <TextBlock Text="{loc:Localize Key=Nav.General}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Language. The list itself is built in code-behind from Loc.Available so
                             the languages Anchor ships are declared in exactly one place. Changing
                             it takes effect immediately: every window is rebuilt in place, which
                             is why there is no longer a "restart to finish" prompt here. -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xF2B7;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Language}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.LanguageDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageChoice" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{loc:Localize Key=Settings.Language}"
                                          SelectionChanged="LanguageChoice_SelectionChanged" />
                            </Grid>
                        </Border>


                        <!-- Running-app indicators -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9D9;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.RunningIndicators}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.RunningIndicatorsDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RunningIndicatorsSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.RunningIndicators}"
                                              Toggled="RunningIndicatorsSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Open apps that aren't pinned, as in the macOS Dock -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE737;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.RunningApps}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.RunningAppsDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="RunningAppsSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.RunningApps}"
                                              Toggled="RunningAppsSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- A divider between pinned icons and open apps, or one row -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE76F;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.OpenAppsDivider}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.OpenAppsDividerDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="OpenAppsDividerSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.OpenAppsDivider}"
                                              Toggled="OpenAppsDividerSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Startup -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7E8;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.Startup}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.StartupDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartupSwitch" Grid.Column="2"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="{loc:Localize Key=Settings.Startup}"
                                                  Toggled="StartupSwitch_Toggled" />
                                </Grid>

                                <!-- Only ever shown on the packaged build, and only when Windows
                                     itself is holding the entry off: a startup task the user
                                     disabled in Task Manager cannot be re-enabled by the app, so
                                     the switch springs back and this says who can. -->
                                <muxc:InfoBar x:Name="StartupBlockedBar" IsOpen="False" IsClosable="True"
                                              Visibility="Collapsed"
                                              Severity="Warning"
                                              Message="{loc:Localize Key=Settings.StartupBlocked}" />
                            </StackPanel>
                        </Border>

                        <!-- Backup: export the whole configuration, or restore one. -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8B5;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.Backup}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.BackupDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Button Content="{loc:Localize Key=Settings.Export}"
                                                Click="Export_Click" />
                                        <Button Content="{loc:Localize Key=Settings.Import}"
                                                Click="Import_Click" />
                                    </StackPanel>
                                </Grid>

                                <muxc:InfoBar x:Name="BackupBar" IsOpen="False" IsClosable="True"
                                              Visibility="Collapsed"
                                              Severity="Success" />
                            </StackPanel>
                        </Border>

                        <!-- Maintenance -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE777;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.ResetSection}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.ResetSectionDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{loc:Localize Key=Settings.Reset}"
                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Click="Reset_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== APPEARANCE ====================
                     Personalization that applies to every dock: how big the cells are, how the
                     glass is tinted, and whether icons swell under the cursor. -->
                <ScrollViewer x:Name="AppearancePanel" Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              AutomationProperties.AutomationId="SettingsAppearancePanel">
                    <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{loc:Localize Key=Nav.Appearance}"
                                       Style="{ThemeResource TitleTextBlockStyle}"
                                       VerticalAlignment="Center" />
                            <!-- Only shown once the theme choice has actually changed from what it
                                 was when Settings opened (see SettingsWindow.xaml.cs,
                                 ThemeChoice_SelectionChanged) — the live switch doesn't always
                                 finish repainting the glass cleanly, so this is the reliable
                                 fallback: a fresh process always renders clean. -->
                            <Button x:Name="RestartButton" Grid.Column="1"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="SettingsRestartButton"
                                    Click="RestartButton_Click">
                                <ToolTipService.ToolTip>
                                    <ToolTip Content="{loc:Localize Key=Settings.RestartToApplyTip}" />
                                </ToolTipService.ToolTip>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE72C;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="14" />
                                    <TextBlock Text="{loc:Localize Key=Settings.RestartToApply}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Theme -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE771;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Theme}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.ThemeDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeChoice" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{loc:Localize Key=Settings.Theme}"
                                          SelectionChanged="ThemeChoice_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Localize Key=Theme.Light}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Theme.Dark}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Theme.System}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Icon size / density -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE740;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Density}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.DensityDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="DensityChoice" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{loc:Localize Key=Settings.Density}"
                                          SelectionChanged="DensityChoice_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Localize Key=Density.Small}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Density.Medium}" />
                                    <ComboBoxItem Content="{loc:Localize Key=Density.Large}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Settings gear on the dock, or only on its right-click menu -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE713;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.ShowSettingsButton}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.ShowSettingsButtonDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowSettingsButtonSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.ShowSettingsButton}"
                                              Toggled="ShowSettingsButtonSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Settings gear position -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE713;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.SettingsPosition}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.SettingsPositionDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="SettingsPositionChoice" Grid.Column="2" MinWidth="170" Width="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Right"
                                          AutomationProperties.Name="{loc:Localize Key=Settings.SettingsPosition}"
                                          SelectionChanged="SettingsPositionChoice_SelectionChanged">
                                    <ComboBoxItem Content="{loc:Localize Key=SettingsPosition.Trailing}" />
                                    <ComboBoxItem Content="{loc:Localize Key=SettingsPosition.Leading}" />
                                </ComboBox>
                            </Grid>
                        </Border>

                        <!-- Magnification -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8A3;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.Magnify}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.MagnifyDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="MagnifySwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.Magnify}"
                                              Toggled="MagnifySwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Group fly-out: on hover, or click-only -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE962;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.GroupOpenOnHover}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.GroupOpenOnHoverDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="GroupOpenOnHoverSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.GroupOpenOnHover}"
                                              Toggled="GroupOpenOnHoverSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Persistent item labels -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8D2;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.ShowItemLabels}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.ShowItemLabelsDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="ShowItemLabelsSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.ShowItemLabels}"
                                              Toggled="ShowItemLabelsSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Accent tint -->
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE790;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.AccentTint}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.AccentTintDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="AccentTintSwitch" Grid.Column="2"
                                              OnContent="" OffContent="" MinWidth="0"
                                              HorizontalAlignment="Right"
                                              AutomationProperties.Name="{loc:Localize Key=Settings.AccentTint}"
                                              Toggled="AccentTintSwitch_Toggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xF570;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{loc:Localize Key=Settings.GlassTransparency}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{loc:Localize Key=Settings.GlassTransparencyDesc}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Slider x:Name="GlassTransparencySlider" Grid.Column="2"
                                        Width="180" Minimum="0" Maximum="100" StepFrequency="5"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{loc:Localize Key=Settings.GlassTransparency}"
                                        ValueChanged="GlassTransparencySlider_ValueChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== SHORTCUTS ====================
                     Everything system-wide Anchor registers with Windows, in one place: the
                     shortcut that summons the docks, the one that opens quick-launch search, and
                     the master switch for the per-item ones (assigned from an icon's own menu). -->
                <ScrollViewer x:Name="ShortcutsPanel" Visibility="Collapsed"
                              HorizontalContentAlignment="Stretch"
                              AutomationProperties.AutomationId="SettingsShortcutsPanel">
                    <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                        <TextBlock Text="{loc:Localize Key=Nav.Shortcuts}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Summon the docks -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE765;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.Hotkey}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.HotkeyDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- The on/off switch and the capture button (added in
                                         code-behind, see HotkeyCaptureButton) share one row at the
                                         right edge of the card: toggle first, then the key. -->
                                    <StackPanel x:Name="HotkeyColumn" Grid.Column="2"
                                                Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <ToggleSwitch x:Name="HotkeySwitch"
                                                      OnContent="" OffContent="" MinWidth="0"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.Name="{loc:Localize Key=Settings.Hotkey}"
                                                      Toggled="HotkeySwitch_Toggled" />
                                    </StackPanel>
                                </Grid>

                                <muxc:InfoBar x:Name="HotkeyBar" IsOpen="False" IsClosable="False"
                                              Visibility="Collapsed"
                                              Severity="Warning" />
                            </StackPanel>
                        </Border>

                        <!-- Quick-launch search -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE721;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.SearchHotkey}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.SearchHotkeyDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="SearchHotkeyColumn" Grid.Column="2"
                                                VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>

                                <muxc:InfoBar x:Name="SearchHotkeyBar" IsOpen="False" IsClosable="False"
                                              Visibility="Collapsed"
                                              Severity="Warning" />
                            </StackPanel>
                        </Border>

                        <!-- Per-item shortcuts -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7C1;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="18" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{loc:Localize Key=Settings.ItemHotkeys}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=Settings.ItemHotkeysDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="ItemHotkeysSwitch" Grid.Column="2"
                                                  OnContent="" OffContent="" MinWidth="0"
                                                  HorizontalAlignment="Right"
                                                  AutomationProperties.Name="{loc:Localize Key=Settings.ItemHotkeys}"
                                                  Toggled="ItemHotkeysSwitch_Toggled" />
                                </Grid>

                                <!-- What is currently assigned, so the shortcuts aren't invisible
                                     once they're spread across a dozen right-click menus. -->
                                <StackPanel x:Name="ItemHotkeyList" Spacing="4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ==================== DOCKS ====================
                     One card per dock, built in code-behind (DocksList): the number of docks —
                     and of monitors to offer each one — is only known at runtime, and each card
                     carries the settings that used to sit on the General page back when there
                     was exactly one dock to apply them to. -->
                <Grid x:Name="DocksPanel" Visibility="Collapsed" RowSpacing="12"
                      AutomationProperties.AutomationId="SettingsDocksPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{loc:Localize Key=Nav.Docks}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button Content="{loc:Localize Key=Docks.Add}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="AddDock_Click" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{loc:Localize Key=Docks.Hint}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="DocksList" Spacing="8" HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="SettingsDocksList" />
                    </ScrollViewer>
                </Grid>

                <!-- ==================== APPS ==================== -->
                <Grid x:Name="AppsPanel" Visibility="Collapsed" RowSpacing="12"
                      AutomationProperties.AutomationId="SettingsAppsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{loc:Localize Key=Nav.Apps}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{ThemeResource AccentButtonStyle}"
                                AutomationProperties.Name="{loc:Localize Key=Apps.AddNew}" Click="AddNew_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                                <TextBlock Text="{loc:Localize Key=Apps.AddNew}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Text="{loc:Localize Key=Apps.Hint}"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />

                    <ScrollViewer Grid.Row="2" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="AppsList" Spacing="8" HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="SettingsAppsList" />
                    </ScrollViewer>

                    <!-- Floating copy of whichever row is being dragged (see SettingsWindow.xaml.cs,
                         ShowDragGhost) — same cell as the ScrollViewer above so it overlays the list;
                         declared after it so it paints on top. Never hit-test visible: it only ever
                         tracks the cursor, and must never itself become the thing FindRowAt lands on. -->
                    <Canvas x:Name="DragGhostCanvas" Grid.Row="2" IsHitTestVisible="False" />
                </Grid>

                <!-- ==================== ABOUT ==================== -->
                <ScrollViewer x:Name="AboutPanel" Visibility="Collapsed">
                    <!-- Stretch so the cards fill the page width whether or not the Privacy
                         expander is open (a Left-aligned panel would size to its content and
                         only widen once the long expanded text appears). -->
                    <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                        <TextBlock Text="{loc:Localize Key=Nav.About}"
                                   Style="{ThemeResource TitleTextBlockStyle}"
                                   Margin="0,0,0,12" />

                        <!-- Identity + developer -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <!-- The real app logo, not a stand-in glyph. targetsize-256 is the
                                         largest unpadded variant, so it stays crisp at 56px. -->
                                    <Border Width="56" Height="56" CornerRadius="12">
                                        <Image Source="ms-appx:///Images/Square44x44Logo.targetsize-256.png"
                                               Width="56" Height="56" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Anchor" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                        <TextBlock x:Name="VersionText"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{loc:Localize Key=About.Tagline}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{loc:Localize Key=About.Credits}" />

                                <!-- HyperlinkButton opens the URI with the default browser; no
                                     code-behind needed. Margin trims the button's built-in padding
                                     so the links line up with the text above. -->
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Left">
                                    <HyperlinkButton Content="{loc:Localize Key=About.License}"
                                                     NavigateUri="https://github.com/framedparadox/anchor-dock/blob/main/LICENSE" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.PrivacyPolicy}"
                                                     NavigateUri="https://www.anchordock-app.com/privacy.html" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.Website}"
                                                     NavigateUri="https://www.anchordock-app.com" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.Changelog}"
                                                     NavigateUri="https://www.anchordock-app.com/changelog.html" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE939;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{loc:Localize Key=About.Support}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=About.SupportDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            HorizontalAlignment="Left">
                                    <HyperlinkButton Content="{loc:Localize Key=About.RateStore}"
                                                     NavigateUri="https://apps.microsoft.com/detail/9nlp5cwmkdj0" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.StarGitHub}"
                                                     NavigateUri="https://github.com/framedparadox/anchor-dock" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.Feedback}"
                                                     NavigateUri="https://www.anchordock-app.com/feedback.html" />
                                    <HyperlinkButton Content="{loc:Localize Key=About.ReportIssue}"
                                                     NavigateUri="https://github.com/framedparadox/anchor-dock/issues" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Shown only when a background check (or one from the tray) has already
                             found a release; there is no manual "check now" control here anymore. -->
                        <muxc:InfoBar x:Name="UpdateBar" IsOpen="False" IsClosable="False"
                                      Visibility="Collapsed"
                                      Severity="Informational" />

                        <!-- Privacy: collapsed by default; expand for the details. -->
                        <Expander HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch"
                                  IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE72E;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Localize Key=About.Privacy}"
                                                   Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{loc:Localize Key=About.PrivacyDesc}"
                                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Localize Key=About.PrivacyLocal}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Localize Key=About.PrivacyLocalBody}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Localize Key=About.PrivacyIcons}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Localize Key=About.PrivacyIconsBody}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{loc:Localize Key=About.PrivacyTracking}"
                                               Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{loc:Localize Key=About.PrivacyTrackingBody}" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </muxc:NavigationView>
    </Grid>
</Window>
