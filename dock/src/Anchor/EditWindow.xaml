<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anchor.EditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Anchor.Localization">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- A round colour swatch: the colour is the content, inset so the checked state's
                 accent fill shows as a ring around the chosen one. -->
            <Style x:Key="ColourSwatchStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: extended into so the Mica backdrop flows edge-to-edge and the
             caption matches a native Windows 11 window (no opaque white strip). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                        Margin="14,0,0,0">
                <FontIcon Glyph="&#xE70F;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{loc:Localize Key=Edit.Title}" Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Both rows are Auto and the window is sized to them: a star-sized form row stretched
             to a fixed window height, which left a band of dead space under the fields. -->
        <Grid Grid.Row="1" Padding="24,8,24,20" RowSpacing="16" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Heading: the item as the dock draws it, so it is obvious which one is being
                 edited with several similarly-named items on the strip, with Save at the far end
                 of the same row. The icon itself is filled in from code (it can resolve
                 asynchronously, and it changes while this window is open). -->
            <Grid Grid.Row="0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid x:Name="HeroIcon" Width="24" Height="24" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HeroName" Style="{ThemeResource TitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="HeroKind" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Hugs its glyph rather than sitting in the wide caption-sized box a MinWidth
                     would give it. -->
                <Button x:Name="SaveButton" Grid.Column="2" Style="{ThemeResource AccentButtonStyle}"
                        Width="40" Height="32" MinWidth="0" Padding="0"
                        VerticalAlignment="Center" HorizontalAlignment="Right"
                        Click="Save_Click"
                        AutomationProperties.Name="{loc:Localize Key=Common.Save}">
                    <FontIcon Glyph="&#xE74E;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="16" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Enter" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <!-- Form -->
            <StackPanel Grid.Row="1" Spacing="14">
                <!-- Name and icon share a line. The icon side is sized to what is in it — a
                     preview and the two buttons that act on it — and pinned to the right edge;
                     the name box takes everything left over, which is the field that can actually
                     use the room. -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="{loc:Localize Key=Flyout.Name}" />
                        <TextBox x:Name="NameBox"
                                 AutomationProperties.Name="{loc:Localize Key=Flyout.Name}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6" HorizontalAlignment="Right">
                        <TextBlock Text="{loc:Localize Key=Flyout.Icon}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="32" Height="32" CornerRadius="6"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid x:Name="IconPreview" Width="20" Height="20" />
                            </Border>
                            <!-- The picker opens as a flyout on this button. Inside a real window
                                 that costs nothing: dismissing it leaves the form exactly as it
                                 was, which is the whole reason this editor is a window and not a
                                 fly-out of its own — a picker opened from inside one closed the
                                 editor with it. -->
                            <Button x:Name="ChangeIconButton" Click="ChangeIcon_Click"
                                    Width="36" Height="32" MinWidth="0" Padding="0"
                                    AutomationProperties.Name="{loc:Localize Key=Menu.ChangeIcon}">
                                <FontIcon Glyph="&#xE70F;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="14" />
                            </Button>
                            <!-- Only shown while there is a picked icon to drop back to the one
                                 Windows (or the site) gave the item. -->
                            <Button x:Name="ResetIconButton" Click="ResetIcon_Click"
                                    Width="36" Height="32" MinWidth="0" Padding="0"
                                    AutomationProperties.Name="{loc:Localize Key=Menu.ResetIcon}">
                                <FontIcon Glyph="&#xE7A7;" FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="14" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Collapsed for a group, which points at nothing of its own. -->
                <StackPanel x:Name="TargetPanel" Spacing="6">
                    <TextBlock Text="{loc:Localize Key=Add.Target}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetBox" Grid.Column="0"
                                 AutomationProperties.Name="{loc:Localize Key=Add.Target}" />
                        <Button x:Name="BrowseButton" Grid.Column="1"
                                Content="{loc:Localize Key=Add.Browse}" Click="Browse_Click" />
                    </Grid>
                </StackPanel>

                <!-- A group's glyph colour, in the row a group has free because it has no target.
                     The theme's own text colour first (no colour of its own, which is what every
                     group had before), then presets from the Windows palette that read on both
                     the light and the dark glass, then a custom one that opens a full picker.
                     Toggle buttons so the chosen one is announced as such, and ringed by the
                     checked state rather than told apart by colour alone. Tag is the colour a
                     swatch picks; the default's is empty. -->
                <StackPanel x:Name="ColourPanel" Spacing="6" Visibility="Collapsed">
                    <TextBlock Text="{loc:Localize Key=Flyout.Colour}" />
                    <StackPanel x:Name="SwatchRow" Orientation="Horizontal" Spacing="6">
                        <ToggleButton Tag="" Style="{StaticResource ColourSwatchStyle}" Click="Swatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Default}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Default}">
                            <Ellipse Width="24" Height="24"
                                     Fill="{ThemeResource TextFillColorPrimaryBrush}" />
                        </ToggleButton>
                        <ToggleButton Tag="#E74856" Style="{StaticResource ColourSwatchStyle}" Click="Swatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Red}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Red}">
                            <Ellipse Width="24" Height="24" Fill="#E74856" />
                        </ToggleButton>
                        <ToggleButton Tag="#F7630C" Style="{StaticResource ColourSwatchStyle}" Click="Swatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Orange}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Orange}">
                            <Ellipse Width="24" Height="24" Fill="#F7630C" />
                        </ToggleButton>
                        <ToggleButton Tag="#FFB900" Style="{StaticResource ColourSwatchStyle}" Click="Swatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Yellow}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Yellow}">
                            <Ellipse Width="24" Height="24" Fill="#FFB900" />
                        </ToggleButton>
                        <ToggleButton Tag="#16C60C" Style="{StaticResource ColourSwatchStyle}" Click="Swatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Green}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Green}">
                            <Ellipse Width="24" Height="24" Fill="#16C60C" />
                        </ToggleButton>
                        <ToggleButton Tag="#00B7C3" Style="{StaticResource ColourSwatchStyle}" Click="Swatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Teal}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Teal}">
                            <Ellipse Width="24" Height="24" Fill="#00B7C3" />
                        </ToggleButton>
                        <ToggleButton Tag="#0078D4" Style="{StaticResource ColourSwatchStyle}" Click="Swatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Blue}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Blue}">
                            <Ellipse Width="24" Height="24" Fill="#0078D4" />
                        </ToggleButton>
                        <ToggleButton Tag="#8764B8" Style="{StaticResource ColourSwatchStyle}" Click="Swatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Purple}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Purple}">
                            <Ellipse Width="24" Height="24" Fill="#8764B8" />
                        </ToggleButton>
                        <ToggleButton Tag="#E3008C" Style="{StaticResource ColourSwatchStyle}" Click="Swatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Pink}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Pink}">
                            <Ellipse Width="24" Height="24" Fill="#E3008C" />
                        </ToggleButton>
                        <ToggleButton x:Name="CustomSwatch" Style="{StaticResource ColourSwatchStyle}"
                                      Click="CustomSwatch_Click"
                                      ToolTipService.ToolTip="{loc:Localize Key=Colour.Custom}"
                                      AutomationProperties.Name="{loc:Localize Key=Colour.Custom}">
                            <Grid>
                                <!-- Filled with the colour once a custom one is in use; until then
                                     just the palette glyph. -->
                                <Ellipse x:Name="CustomSwatchFill" Width="24" Height="24" />
                                <FontIcon x:Name="CustomSwatchGlyph" Glyph="&#xE790;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="14" />
                            </Grid>
                        </ToggleButton>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
